# WattWise AI Environment Configuration
# Copy this file to .env and configure credentials as needed.
# For DEMO MODE, all features run automatically without any credentials.

PORT=3001
NODE_ENV=development

# Google Home / Google HomeGraph OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# Matter Protocol Integration
# Requires physical Matter Border Router / Controller (e.g., Apple HomePod, Google Nest Hub, Home Assistant SkyConnect)
MATTER_FABRIC_ID=wattwise-matter-fabric-01
MATTER_CONTROLLER_ENDPOINT=http://localhost:5580

# Generic Smart Device Cloud API (Tuya, Shelly, TP-Link, MQTT Gateway)
SMART_DEVICE_API_URL=https://api.smartdevice.example.com/v1
SMART_DEVICE_API_KEY=your_api_key_here
